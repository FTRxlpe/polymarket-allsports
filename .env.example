# Copy this file to .env and fill in the values below.
# cp .env.example .env

# Keep this true until you've run the bot in paper mode for at least a few
# days and read every file in this project. Never share WALLET_PRIVATE_KEY.
PAPER_TRADING=true

# The public address of the wallet you'll eventually trade from (used for
# logging/reference; required even in paper mode).
WALLET_ADDRESS=

# Only needed once you set PAPER_TRADING=false. Use a dedicated wallet
# funded only with the amount you're willing to risk — never your main
# wallet, and never share this key with anyone.
WALLET_PRIVATE_KEY=

# Starting bankroll in USD, used to pick the bet-sizing tier in config.py.
STARTING_BANKROLL=100

# How often (seconds) to poll each watched wallet's trade history.
POLL_INTERVAL_SECONDS=5
