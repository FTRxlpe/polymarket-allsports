# Copy to .env and edit. Never commit the real .env file.

PAPER_TRADING=true

SPORT_TAG_SLUG=tennis

MIN_BUCKET_SAMPLES=30
MIN_EV_ROI=0.02
KELLY_MULTIPLIER=0.25
MAX_FRACTION_PER_BET=0.05

MAX_OPEN_POSITIONS=5
MAX_BETS_PER_DAY=10
DAILY_LOSS_CAP_FRACTION=0.10
LOSS_STREAK_PAUSE=5
COOLDOWN_MINUTES=60

STARTING_BANKROLL=100
POLL_INTERVAL_SECONDS=30

# Only needed for live trading (PAPER_TRADING=false). Use a DEDICATED
# wallet funded only with what you can afford to lose. Never reuse a
# wallet that holds other funds, and never share this key with anyone.
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
